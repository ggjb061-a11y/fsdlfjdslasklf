# AutoVulnScan - Example environment configuration.
# Copy to .env and edit for your environment. The scanner reads NOTHING
# from this file by default - it is a template of what you can set in
# your shell to influence behavior.

# ----- Proxy (optional) ------------------------------------------------
# Routes all HTTP(S) traffic through the given proxy. Useful for Burp/ZAP.
# Equivalent to passing --proxy on the CLI.
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# ----- Webhook notifications ------------------------------------------
# Slack/Discord webhook for scan completion.
# WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ----- Custom wordlist path -------------------------------------------
# Overrides the built-in wordlist search for directory brute-force.
# WORDLIST=/opt/wordlists/custom.txt

# ----- Nuclei templates path ------------------------------------------
# Only if you keep nuclei templates in a non-default location.
# NUCLEI_TEMPLATES=/opt/nuclei-templates

# ----- Thread count ---------------------------------------------------
# Default concurrency; CLI --threads takes precedence.
# AUTOSCAN_THREADS=10

# ----- Rate limiting --------------------------------------------------
# Delay in seconds between requests to the same target.
# AUTOSCAN_RATE_LIMIT=0
